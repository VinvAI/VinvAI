				"title": "View Traces (all traced endpoints)",
				"category": "Vinv",
				"icon": "$(pulse)"
			}
		],
		"keybindings": [
			{
				"command": "vinv-vs.runService",
				"key": "ctrl+alt+r",
				"mac": "cmd+alt+r"
			}
		],
		"debuggers": [
			{
				"type": "vinv-service",
				"label": "Vinv Service",
				"languages": []
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "vinv-vs.optimizeHotspot",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "vinv-vs.stopDiscovery",
					"when": "view == vinv.flow && vinv.discovering",
					"group": "navigation@0"
				},
				{
					"command": "vinv-vs.rediscover",
					"when": "view == vinv.flow && !vinv.discovering",
					"group": "navigation@0"
				},
				{
					"command": "vinv-vs.openGraphExplorer",
					"when": "view == vinv.flow",
					"group": "navigation@1"
				},
				{
					"command": "vinv-vs.openOptimization",
					"when": "view == vinv.flow",
					"group": "navigation@1"
				},
				{
					"command": "vinv-vs.openFindings",
					"when": "view == vinv.flow",
					"group": "navigation@2"
				},
				{
					"command": "vinv-vs.openTraces",
					"when": "view == vinv.flow",
					"group": "navigation@2"
				},
				{
					"command": "vinv-vs.openDeadCode",
					"when": "view == vinv.flow",
					"group": "navigation@3"
				},
				{
					"command": "vinv-vs.configureProject",
					"when": "view == vinv.flow",
					"group": "navigation@9"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run sync-readme && npm run stamp && npm run check && npm run clean-out && npm run bundle",
		"clean-out": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
		"sync-readme": "node ./scripts/sync-readme.mjs --check",
		"stamp": "node ./scripts/stamp-engine-pin.mjs",
		"package": "vsce package --no-rewrite-relative-links",
		"compile": "tsc -p ./",
		"check": "tsc -p ./ --noEmit",
		"bundle": "node ./esbuild.mjs",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src",
		"test": "vscode-test",
		"test:packaged": "npm run bundle && node scripts/test-packaged.mjs",
		"test:e2e": "node scripts/e2e-vsix-run.mjs"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "22.x",
		"@types/vscode": "^1.75.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^3.9.2",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.3",
		"jsdom": "^29.1.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1"
	},
	"overrides": {
		"diff": "^8.0.3",
		"serialize-javascript": "^7.0.7"
	}
}
